{
  "name": "@vizlayer/core",
  "version": "0.1.10",
  "type": "module",
  "description": "Core Vizlayer APIs for typed diagram payloads, Mermaid generation, validation, and repair.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^4.0.6"
  }
}
